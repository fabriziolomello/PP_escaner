PORT=4000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD=password
DB_NAME=escaner

# JWT
JWT_SECRET=cambiar_este_secreto
JWT_EXPIRES_IN=8h

# Cloudinary (se usa mas adelante, para la carga de fotos de producto)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MercadoPago (suscripcion mensual de los comercios)
# Access token de la cuenta que cobra (en pruebas, el de las credenciales de prueba).
MP_ACCESS_TOKEN=
# Precio mensual en ARS.
SUSCRIPCION_PRECIO=10000
# URL publica de la app (https en produccion): MP vuelve ahi despues de pagar
# y manda los webhooks a APP_URL/api/suscripcion/webhook.
APP_URL=http://localhost:4000

# Email (confirmacion de cuenta y recuperar contraseña), por SMTP de la
# casilla de Hostinger. Sin SMTP_HOST los emails se muestran en la consola.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-responder@tudominio.com
SMTP_PASS=
# Remitente (por defecto SMTP_USER; Hostinger exige que sea esa misma casilla).
EMAIL_FROM=
